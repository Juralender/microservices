{
  "info": {
    "name": "userlist",
    "description": "CRUD API tests for the userlist service. Run folders top-to-bottom: Health -> Unauthenticated -> Admin CRUD -> Regular User permissions. Set adminPassword in the environment before running (see postman/userlist.postman_environment.json).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "", "type": "string" },
    { "key": "testUsername", "value": "alice", "type": "string" },
    { "key": "testPassword", "value": "secret123", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "regularUserId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health/liveness",
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health/readiness",
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Unauthenticated",
      "item": [
        {
          "name": "List Users - no credentials -> 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users",
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin CRUD",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Alice A\",\n  \"email\": \"alice@example.com\",\n  \"role\": \"USER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('password not returned', () => pm.expect(body.password).to.be.undefined);",
                  "pm.test('role is USER', () => pm.expect(body.role).to.eql('USER'));",
                  "pm.collectionVariables.set('userId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User - duplicate username -> 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User - validation error -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('username matches', () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('testUsername')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"alice.new@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('email updated', () => pm.expect(pm.response.json().email).to.eql('alice.new@example.com'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User By Id - not found -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/999999",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User By Id - deleted -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Regular User Permissions",
      "item": [
        {
          "name": "Setup - Create Regular User (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"USER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('regularUserId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Users (as regular user) -> 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{testUsername}}", "type": "string" },
                { "key": "password", "value": "{{testPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User (as regular user) -> 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{testUsername}}", "type": "string" },
                { "key": "password", "value": "{{testPassword}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Own User (as regular user) -> 403",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users/{{regularUserId}}",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{testUsername}}", "type": "string" },
                { "key": "password", "value": "{{testPassword}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"self-change@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Own User (as regular user) -> 403",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{regularUserId}}",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{testUsername}}", "type": "string" },
                { "key": "password", "value": "{{testPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cleanup - Delete Regular User (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{regularUserId}}",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUsername}}", "type": "string" },
                { "key": "password", "value": "{{adminPassword}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
